{
  "name": "@sdlcforge/format-and-lint",
  "version": "1.0.0-alpha.30",
  "description": "Pre-configured formatting and style tool combining prettier and eslint.",
  "main": "./dist/fandl.js",
  "type": "module",
  "bin": {
    "fandl": "./dist/fandl-exec.js"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "make",
    "lint": "make lint",
    "lint:fix": "make lint-fix",
    "test": "make test",
    "prepack": "make build",
    "preversion": "make test && make lint",
    "qa": "make qa"
  },
  "keywords": [],
  "author": "Zane Rockenbaugh <zane@liquid-labs.com>",
  "license": "UNLICENSED",
  "repository": {
    "url": "git+ssh://git@github.com/sdlcforge/format-and-lint.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/sdlcforge/format-and-lint/issues"
  },
  "homepage": "https://github.com/sdlcforge/format-and-lint#readme",
  "dependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^8.56.0",
    "@sdlcforge/packjs": "^1.0.0-beta.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "eslint": "^9.12.0",
    "eslint-config-standard-kit": "^1.0.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "find-plus": "^2.0.0",
    "gitignore-to-glob": "^0.3.0",
    "globals": "^17.4.0",
    "js-yaml": "^4.1.1",
    "prettier": "^3.3.3",
    "standard-error-set": "^1.0.0-beta.2"
  },
  "devDependencies": {
    "@liquid-labs/jsdoc-to-markdown": "^9.1.3",
    "@liquid-labs/sdlc-resource-jest": "^1.0.0-alpha.9",
    "dmd-readme-api": "^1.0.0-beta.8",
    "jest": "^30.2.0"
  },
  "_comply": {
    "orgKey": "@liquid-labs"
  },
  "_sdlc": {
    "linting": {
      "ignores": [
        "src/test/data/**"
      ]
    }
  },
  "peerDependencies": {
    "command-line-args": "^6.0.0"
  }
}
